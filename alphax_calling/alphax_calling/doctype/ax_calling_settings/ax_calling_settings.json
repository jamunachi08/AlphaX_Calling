  "fields": [
    {
      "fieldname": "s_general",
      "label": "General",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "enabled",
      "label": "Calling enabled",
      "fieldtype": "Check",
      "default": "1",
      "description": "Master switch. When off, dialing and provider events are refused."
    },
    {
      "fieldname": "provider",
      "label": "Provider",
      "fieldtype": "Select",
      "options": "Manual (phone app)\nTwilio\nCarrier SIP Bridge",
      "default": "Manual (phone app)",
      "description": "Manual: tel: link and manual logging. Twilio: browser calling through a Twilio account (free trial for the pilot). Carrier SIP Bridge: a CST-licensed Saudi carrier via your own SIP/WebRTC bridge."
    },
    {
      "fieldname": "default_country_code",
      "label": "Default country code",
      "fieldtype": "Data",
      "default": "966"
    },
    {
      "fieldname": "public_url",
      "label": "Public HTTPS URL",
      "fieldtype": "Data",
      "description": "Only if the site sits behind a proxy and its own URL is not the public one, e.g. https://crm.example.com"
    },
    {
      "fieldname": "c_general",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "call_window_start",
      "label": "Call window start (HH:MM)",
      "fieldtype": "Data",
      "default": "09:00"
    },
    {
      "fieldname": "call_window_end",
      "label": "Call window end (HH:MM)",
      "fieldtype": "Data",
      "default": "21:00"
    },
    {
      "fieldname": "weekend",
      "label": "Weekend",
      "fieldtype": "Select",
      "options": "Fri-Sat\nThu-Fri\nSat-Sun\nFri only\nNone",
      "default": "Fri-Sat"
    },
    {
      "fieldname": "do_not_call_field",
      "label": "Do-not-call field on Lead",
      "fieldtype": "Data",
      "description": "Fieldname of a Check on Lead. Leave empty to rely on the status 'Do Not Contact'."
    },
    {
      "fieldname": "default_callback_owner",
      "label": "Default callback owner",
      "fieldtype": "Link",
      "options": "User",
      "description": "Fallback owner for missed inbound calls."
    },
    {
      "fieldname": "missed_callback_minutes",
      "label": "Missed-call callback due (minutes)",
      "fieldtype": "Int",
      "default": "60"
    },
    {
      "fieldname": "event_retention_days",
      "label": "Keep raw provider events (days)",
      "fieldtype": "Int",
      "default": "180"
    },
    {
      "fieldname": "s_lines",
      "label": "Business numbers",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "business_lines",
      "label": "Business numbers",
      "fieldtype": "Table",
      "options": "AX Business Line"
    },
    {
      "fieldname": "s_twilio",
      "label": "Twilio",
      "fieldtype": "Section Break",
      "depends_on": "eval:doc.provider=='Twilio'"
    },
    {
      "fieldname": "twilio_account_sid",
      "label": "Account SID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "twilio_auth_token",
      "label": "Auth token",
      "fieldtype": "Password"
    },
    {
      "fieldname": "twilio_api_key_sid",
      "label": "API key SID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "twilio_api_key_secret",
      "label": "API key secret",
      "fieldtype": "Password"
    },
    {
      "fieldname": "c_twilio",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "twilio_twiml_app_sid",
      "label": "TwiML App SID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "twilio_caller_id",
      "label": "Caller ID (E.164)",
      "fieldtype": "Data",
      "description": "Trial number or verified caller ID in the pilot; your registered Saudi number in production."
    },
    {
      "fieldname": "s_bridge",
      "label": "Carrier SIP Bridge",
      "fieldtype": "Section Break",
      "depends_on": "eval:doc.provider=='Carrier SIP Bridge'"
    },
    {
      "fieldname": "webhook_secret",
      "label": "Event signing secret",
      "fieldtype": "Password",
      "description": "Shared with the bridge. Use the Generate secret button."
    },
    {
      "fieldname": "carrier_sip_server",
      "label": "SIP server / host",
      "fieldtype": "Data"
    },
    {
      "fieldname": "carrier_sip_port",
      "label": "SIP port",
      "fieldtype": "Int",
      "default": "5060"
